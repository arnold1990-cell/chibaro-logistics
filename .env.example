# Application: public canonical origin (used at build time)
APP_NAME=Chibaro Logistics
APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
# Database: JDBC URL for local Java process; Compose overrides internal address
DATABASE_URL=jdbc:postgresql://localhost:55433/chibaro
POSTGRES_DB=chibaro
POSTGRES_USER=chibaro
POSTGRES_PASSWORD=
SPRING_PROFILES_ACTIVE=local
REDIS_URL=redis://localhost:56380
# Redis-backed Spring sessions use opaque random IDs; SESSION_SECRET is reserved.
SESSION_SECRET=
COOKIE_SECURE=false
# Bootstrap creates only a missing admin; it never changes existing passwords.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# AI disabled by default. Usage cap is generation count, not a currency budget.
AI_PROVIDER=disabled
AI_MONTHLY_GENERATION_LIMIT=100
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AWS_REGION=
BEDROCK_MODEL_ID=
# OAuth adapters remain disabled until implementation and approval are verified.
INTEGRATION_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
BUSINESS_WHATSAPP=263775008064
BUSINESS_PHONE=263783051430
BUSINESS_EMAIL=kamhungachibs@gmail.com
BUSINESS_LOCATION=Beitbridge
